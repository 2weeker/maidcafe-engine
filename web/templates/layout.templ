package templates

import (
	"maidcafe-engine/app/models"
	"maidcafe-engine/app/tripcode"
	"maidcafe-engine/web/markup"
)

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ p.Theme }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title } :: maidcafe</title>
			<link rel="preload" href="/static/fonts/inter.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/static/css/style.css"/>
		</head>
		<body>
			<div class="wrap" id="top">
				<header class="masthead box">
					<a href="/" class="banner-link"><pre class="banner" aria-label="maidcafe">{ banner }</pre></a>
					<nav class="nav">
						<a href="/">[home]</a>
						@themeToggle(p)
						if Site.Textboard {
							<a href="/name">[name]</a>
						}
						if p.User != nil {
							if p.User.IsMod() {
								<a href="/admin">[admin]</a>
							}
							if Site.Textboard {
								<a href="/settings">[~{ p.User.Username }]</a>
							} else {
								<a href={ templ.URL(userURL(p.User.Username)) }>[~{ p.User.Username }]</a>
							}
							<form method="post" action="/logout" class="inline">
								@csrfField(p)
								<button type="submit" class="link">[logout]</button>
							</form>
						} else if !Site.Textboard {
							<a href="/login">[login]</a>
							if Site.RegistrationOpen {
								<a href="/register">[register]</a>
							}
						}
					</nav>
				</header>
				@searchBar(p)
				if p.Error != "" {
					<div class="box alert" role="alert">!! { p.Error }</div>
				}
				if p.User != nil && p.User.Banned() {
					<div class="box alert" role="alert">
						!! your account is banned. you can read but not post.
						if p.User.BanReason != "" {
							reason: { p.User.BanReason }
						}
					</div>
				}
				if p.User != nil && p.User.DeleteAt != nil {
					<div class="box alert doom" role="alert">
						!! your account and everything you've posted will be deleted on { stamp(*p.User.DeleteAt) } UTC.
						<form method="post" action="/settings/undelete" class="inline">
							@csrfField(p)
							<input type="hidden" name="next" value={ p.Path }/>
							<button type="submit" class="link">[keep my account]</button>
						</form>
					</div>
				}
				<main>
					{ children... }
				</main>
				<footer class="footer" id="bottom">
					<pre>{ footerArt }</pre>
					if Site.About {
						<a href="/about" class="footer-link">[{ Site.AboutTitle }]</a>
					}
					if Site.Textboard && p.User == nil {
						<a href="/login" class="footer-link">[staff]</a>
					}
				</footer>
			</div>
		</body>
	</html>
}

templ themeToggle(p Page) {
	<form method="post" action="/theme" class="inline">
		@csrfField(p)
		<input type="hidden" name="next" value={ p.Path }/>
		<button type="submit" name="theme" value={ NextTheme(p.Theme) } class="link" title={ "switch to " + NextTheme(p.Theme) }>[{ p.Theme }]</button>
	</form>
}

templ pagerNav(pg models.Pager, base, prevLabel, nextLabel string) {
	if pg.HasPrev() || pg.HasNext {
		<nav class="pager" aria-label="pagination">
			if pg.HasPrev() {
				<a href={ templ.URL(PageURL(base, pg.Page-1)) } rel="prev">&lt;&lt; { prevLabel }</a>
			} else {
				<span class="off">&lt;&lt; { prevLabel }</span>
			}
			<span class="pager-no">[ page { itoa(pg.Page) } ]</span>
			if pg.HasNext {
				<a href={ templ.URL(PageURL(base, pg.Page+1)) } rel="next">{ nextLabel } &gt;&gt;</a>
			} else {
				<span class="off">{ nextLabel } &gt;&gt;</span>
			}
		</nav>
	}
}

templ jumpDown() {
	<nav class="jump" aria-label="jump to bottom"><a href="#bottom" class="act">v bottom</a></nav>
}

templ jumpUp() {
	<nav class="jump up" aria-label="jump to top"><a href="#top" class="act">^ top</a></nav>
}

templ authorLink(name, role, postName, trip, anon string) {
	if name == "" && trip != "" {
		if postName == "" {
			<span class="author anon">{ anon }</span>
		} else {
			<span class="author">{ postName }</span>
		}
		<span class="trip">{ tripcode.Mark }{ trip }</span>
	} else if name == "" {
		if Site.Textboard {
			<span class="author anon">{ anon }</span>
		} else {
			<span class="author anon">~deleted</span>
		}
	} else if Site.Textboard {
		<span class="author">~{ name }</span>
		if role == models.RoleMod || role == models.RoleAdmin {
			<span class="capcode">## { role }</span>
		}
	} else {
		<a href={ templ.URL(userURL(name)) } class="author">~{ name }</a>
	}
}

templ postingAs(v IdentityView) {
	if Site.Textboard {
		<p class="posting-as">
			posting as <b>{ v.Shown() }</b>
			if v.Trip == "" {
				<a href="/name" class="act">set a name &amp; tripcode</a>
			} else {
				<a href="/name" class="act">change</a>
			}
		</p>
	}
}

templ staffCheck(p Page, on bool) {
	if Site.Textboard && p.User.IsMod() {
		<label class="check">
			<input type="checkbox" name="staff" value="1" checked?={ on }/>
			sign as ~{ p.User.Username } <span class="muted">(## { p.User.Role })</span>
		</label>
	}
}

templ csrfField(p Page) {
	<input type="hidden" name="_csrf" value={ p.CSRF }/>
}

templ sectionHead(title string) {
	<h2 class="section-head"><span class="rule">==[</span> { title } <span class="rule">]==</span></h2>
}

templ loginPrompt(action string) {
	if Site.RegistrationOpen {
		<p class="box muted"><a href="/login">log in</a> or <a href="/register">register</a> to { action }.</p>
	} else {
		<p class="box muted"><a href="/login">log in</a> to { action }.</p>
	}
}

templ ErrorPage(p Page, code int, msg string) {
	@Layout(p) {
		<section class="box">
			<h1 class="huge">{ itoa(code) }</h1>
			<p>{ msg }</p>
			<p><a href="/">&lt;&lt; back home</a></p>
		</section>
	}
}

templ markdown(src string) {
	@templ.Raw(markup.Render(src))
}

templ formatHint() {
	<p class="hint">**bold** *italic* ~~strike~~ `code` ```block``` [link](url) &gt; quote &gt;text [spoiler]hidden[/spoiler] &gt;&gt;1 [aa]art[/aa]</p>
}
