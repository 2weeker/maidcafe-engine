package templates

import "maidcafe-engine/app/models"

templ InboxPage(p Page, v InboxView) {
	@Layout(p) {
		<div class="profile-head dm-head">
			<h1 class="huge">messages</h1>
			<span class="dm-tools"><a href="/dm/channels" class="act">public channels</a></span>
		</div>
		<p class="muted">
			to message someone, press <span class="act">message</span> on their profile.
			if v.Retention > 0 {
				messages vanish after { plural(v.Retention, "hour") }.
			}
		</p>
		if len(v.Invites) > 0 {
			@sectionHead("invites")
			<ul class="inbox">
				for _, inv := range v.Invites {
					<li class="box unread">
						<div class="inbox-link">
							<span class="meta">
								<span class="author">#{ inv.Name }</span>
								<span class="tag">{ inv.Visibility }</span>
								<span class="muted">{ plural(inv.Members, "member") }</span>
								<time>{ stamp(inv.LastMessageAt) }</time>
							</span>
							<span class="snippet">~{ inv.InvitedBy } invited you.</span>
							<span class="dm-tools invite-tools">
								<form method="post" action={ templ.URL(ChannelURL(inv.Name) + "/join") } class="inline">
									@csrfField(p)
									<button type="submit" class="act on">join</button>
								</form>
								<form method="post" action={ templ.URL(ChannelURL(inv.Name) + "/decline") } class="inline">
									@csrfField(p)
									<button type="submit" class="act">decline</button>
								</form>
							</span>
						</div>
					</li>
				}
			</ul>
		}
		@sectionHead("conversations")
		if len(v.Conversations) == 0 {
			<p class="muted">-- no conversations yet. --</p>
		} else {
			<ul class="inbox">
				for _, cv := range v.Conversations {
					<li class={ "box", templ.KV("unread", cv.Unread > 0) }>
						<a href={ templ.URL(convURL(cv)) } class="inbox-link">
							<span class="meta">
								if cv.IsGroup() {
									<span class="author">#{ cv.Name }</span>
								} else {
									<span class="author">~{ cv.Other }</span>
								}
								if cv.Unread > 0 {
									<span class="tag">{ itoa(cv.Unread) } new</span>
								}
								<time>{ stamp(cv.LastMessageAt) }</time>
							</span>
							<span class="snippet">
								switch cv.LastKind {
									case models.KindJoin:
										<span class="muted">--&gt; ~{ cv.LastSender } joined</span>
									case models.KindLeave:
										<span class="muted">&lt;-- ~{ cv.LastSender } left</span>
									case models.KindInvite:
										<span class="muted">~{ cv.LastSender } invited ~{ cv.LastTarget }</span>
									case models.KindCreate:
										<span class="muted">~{ cv.LastSender } created the channel</span>
									default:
										if cv.LastSender == "" {
											<span class="muted">(empty)</span>
										} else if cv.IsGroup() || cv.LastSender == cv.Other {
											<span class="muted">~{ cv.LastSender }:</span>
											{ snippet(cv.LastBody, 120) }
										} else {
											<span class="muted">you:</span>
											{ snippet(cv.LastBody, 120) }
										}
								}
							</span>
						</a>
					</li>
				}
			</ul>
			@pagerNav(v.Pager, "/dm", "newer", "older")
		}
		@sectionHead("new channel")
		<form method="post" action="/dm/channels" class="box compose tag-create">
			@csrfField(p)
			<label for="channel-name">channel name <span class="muted">(1-{ itoa(models.MaxChannelName) } chars: a-z 0-9 - _)</span></label>
			<div class="row-between">
				<span class="tag-input"><span class="hash">#</span><input id="channel-name" type="text" name="name" maxlength={ itoa(models.MaxChannelName) } pattern="[A-Za-z0-9][A-Za-z0-9_-]*" value={ v.Draft.Name } required autocomplete="off"/></span>
				<span class="dm-tools">
					<label class="check"><input type="radio" name="visibility" value="public" checked?={ v.Draft.Visibility != "private" }/> public</label>
					<label class="check"><input type="radio" name="visibility" value="private" checked?={ v.Draft.Visibility == "private" }/> private</label>
					<button type="submit">create</button>
				</span>
			</div>
			<p class="hint">public channels are listed and anyone can join. private ones are invite-only.</p>
		</form>
	}
}

templ ChannelsPage(p Page, v ChannelsView) {
	@Layout(p) {
		<p class="crumbs"><a href="/dm">&lt;&lt; messages</a></p>
		<h1 class="huge">public channels</h1>
		if len(v.Groups) == 0 {
			<p class="muted">-- no public channels yet. make one from your <a href="/dm">messages</a> page. --</p>
		} else {
			<table class="box threads">
				<thead>
					<tr><th>channel</th><th>members</th><th>made by</th><th>active</th><th></th></tr>
				</thead>
				<tbody>
					for _, g := range v.Groups {
						<tr>
							<td><a href={ templ.URL(ChannelURL(g.Name)) } class="thread-title">#{ g.Name }</a></td>
							<td class="num">{ itoa(g.Members) }</td>
							<td>
								if g.CreatedBy != "" {
									<a href={ templ.URL(userURL(g.CreatedBy)) }>~{ g.CreatedBy }</a>
								}
							</td>
							<td><time>{ stamp(g.LastMessageAt) }</time></td>
							<td>
								if g.MyState == models.StateJoined {
									<span class="tag">joined</span>
								} else if p.User != nil {
									<form method="post" action={ templ.URL(ChannelURL(g.Name) + "/join") } class="inline">
										@csrfField(p)
										<button type="submit" class="act">join</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			@pagerNav(v.Pager, "/dm/channels", "prev", "next")
		}
	}
}

templ ChatPage(p Page, v ChatView) {
	@Layout(p) {
		<p class="crumbs"><a href="/dm">&lt;&lt; messages</a></p>
		<section class="chat box">
			<header class="chat-bar">
				<span class="chat-title">{ v.Title }</span>
				if v.Group != nil {
					<span class="chat-topic">{ v.Group.Visibility } :: { plural(v.Group.Members, "member") }</span>
				} else if v.Other != nil {
					<a href={ templ.URL(userURL(v.Other.Username)) }>[profile]</a>
				}
				if v.Retention > 0 {
					<span class="chat-topic">:: messages vanish after { itoa(v.Retention) }h</span>
				}
				<span class="chat-status" id="chat-status" data-state="static">
					if v.Member && v.Pager.Page == 1 {
						<a href={ templ.URL(v.Base + "#latest") }>[refresh]</a>
					}
				</span>
			</header>
			<div class="chat-main">
				<div
					class="chat-log"
					id="chat-log"
					if v.Member && v.Pager.Page == 1 {
						data-events={ v.Base + "/events" }
						data-last={ lastMessageID(v.Messages) }
					}
				>
					if !v.Member {
						@notMember(p, v)
					} else {
						if v.Pager.HasNext {
							<p class="irc-sys"><a href={ templ.URL(PageURL(v.Base, v.Pager.Page+1)) }>-- older messages --</a></p>
						} else {
							<p class="irc-sys">-- start of { v.Title } --</p>
						}
						if len(v.Messages) == 0 {
							<p class="irc-sys irc-empty">-- no messages yet. say hi. --</p>
						}
						for i, m := range v.Messages {
							if i == 0 || day(m.CreatedAt) != day(v.Messages[i-1].CreatedAt) {
								<p class="irc-sys">-- day changed to { day(m.CreatedAt) } --</p>
							}
							@ChatLine(m)
						}
						if v.Pager.HasPrev() {
							<p class="irc-sys"><a href={ templ.URL(PageURL(v.Base, v.Pager.Page-1)) }>-- newer messages --</a></p>
						}
					}
					<span id="latest"></span>
				</div>
				if v.Group != nil && v.Member {
					<aside class="chat-names">
						<p class="names-head">{ itoa(len(v.Members)) } in { v.Title }</p>
						<ul>
							for _, m := range v.Members {
								<li><a href={ templ.URL(userURL(m)) }>{ m }</a></li>
							}
						</ul>
					</aside>
				}
			</div>
			if v.Member && v.Pager.Page == 1 {
				<form method="post" action={ templ.URL(v.Base) } class="chat-form" id="chat-form">
					@csrfField(p)
					<span class="chat-prompt" aria-hidden="true">&gt;</span>
					<textarea name="body" rows="1" maxlength={ itoa(models.MaxMessage) } required autofocus aria-label={ "message " + v.Title } placeholder="say something (enter sends)">{ v.Draft }</textarea>
					<button type="submit">send</button>
					<span class="chat-tools">
						if v.Group != nil {
							<details class="invite">
								<summary class="act">invite</summary>
								<form method="post" action={ templ.URL(v.Base + "/invite") } class="invite-form">
									@csrfField(p)
									<input type="text" name="username" placeholder="username" required autocomplete="off"/>
									<button type="submit" class="act">send invite</button>
								</form>
							</details>
						}
						if v.CanLeave {
							<form method="post" action={ templ.URL(v.Base + "/leave") } class="inline">
								@csrfField(p)
								<button type="submit" class="act" title="leave this chat">leave</button>
							</form>
						}
					</span>
				</form>
			}
		</section>
		if v.Member && v.Pager.Page == 1 {
			<script src="/static/js/chat.js" defer></script>
		}
	}
}

templ notMember(p Page, v ChatView) {
	if v.Invited {
		<p class="irc-sys">-!- you've been invited to { v.Title }.</p>
	} else if v.Left {
		<p class="irc-sys">&lt;-- you left { v.Title }.</p>
	} else if v.Group != nil && v.Group.Visibility == models.Private {
		<p class="irc-sys">-!- { v.Title } is private. you need an invite from a member.</p>
	} else {
		<p class="irc-sys">-!- you're not in { v.Title }.</p>
	}
	if v.CanJoin {
		<form method="post" action={ templ.URL(v.Base + "/join") } class="irc-sys">
			@csrfField(p)
			<button type="submit" class="act on">join { v.Title }</button>
			if v.Invited {
				<a href={ templ.URL("/dm") } class="act">later</a>
			}
		</form>
	}
}

templ ChatLine(m models.Message) {
	switch m.Kind {
		case models.KindJoin:
			<div class="irc sys" id={ msgID(m.ID) } data-day={ day(m.CreatedAt) }>
				<time class="irc-t">[{ clock(m.CreatedAt) }]</time>
				<span class="irc-sys-mark">--&gt;</span>
				<span class="irc-msg">{ m.Sender } has joined</span>
			</div>
		case models.KindLeave:
			<div class="irc sys" id={ msgID(m.ID) } data-day={ day(m.CreatedAt) }>
				<time class="irc-t">[{ clock(m.CreatedAt) }]</time>
				<span class="irc-sys-mark">&lt;--</span>
				<span class="irc-msg">{ m.Sender } has left</span>
			</div>
		case models.KindInvite:
			<div class="irc sys" id={ msgID(m.ID) } data-day={ day(m.CreatedAt) }>
				<time class="irc-t">[{ clock(m.CreatedAt) }]</time>
				<span class="irc-sys-mark">-!-</span>
				<span class="irc-msg">{ m.Sender } invited { m.Target }</span>
			</div>
		case models.KindCreate:
			<div class="irc sys" id={ msgID(m.ID) } data-day={ day(m.CreatedAt) }>
				<time class="irc-t">[{ clock(m.CreatedAt) }]</time>
				<span class="irc-sys-mark">***</span>
				<span class="irc-msg">{ m.Sender } created the channel ({ m.Body })</span>
			</div>
		default:
			<div class={ "irc", templ.KV("mine", m.Mine) } id={ msgID(m.ID) } data-day={ day(m.CreatedAt) }>
				<time class="irc-t" datetime={ m.CreatedAt.UTC().Format("2006-01-02T15:04:05Z") }>[{ clock(m.CreatedAt) }]</time>
				<span class="irc-nick">&lt;{ m.Sender }&gt;</span>
				<div class="irc-msg">
					@markdown(m.Body)
				</div>
			</div>
	}
}
