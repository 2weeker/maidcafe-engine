package templates

templ Login(p Page, f AuthForm) {
	@Layout(p) {
		<form method="post" action="/login" class="box auth">
			<h1 class="huge">log in</h1>
			@csrfField(p)
			@honeypot(f)
			<label for="username">username</label>
			<input id="username" type="text" name="username" value={ f.Username } autocomplete="username" required autofocus/>
			<label for="password">password</label>
			<input id="password" type="password" name="password" autocomplete="current-password" required/>
			@captchaField(f)
			<div class="row-end"><button type="submit" disabled?={ f.Locked != "" }>enter</button></div>
			if Site.RegistrationOpen {
				<p class="muted small">no account? <a href="/register">register</a>.</p>
			}
		</form>
	}
}

templ Register(p Page, f AuthForm) {
	@Layout(p) {
		<form method="post" action="/register" class="box auth">
			<h1 class="huge">register</h1>
			<p class="muted small">no email. no phone. pick a name and a password. lose the password, lose the account.</p>
			@csrfField(p)
			@honeypot(f)
			<label for="username">username <span class="muted">(3-20: a-z 0-9 _)</span></label>
			<input id="username" type="text" name="username" value={ f.Username } pattern="[A-Za-z0-9_]{3,20}" autocomplete="username" required autofocus/>
			<label for="password">password <span class="muted">(8+ chars)</span></label>
			<input id="password" type="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required/>
			<label for="password_confirm">again</label>
			<input id="password_confirm" type="password" name="password_confirm" minlength="8" maxlength="72" autocomplete="new-password" required/>
			@captchaField(f)
			<div class="row-end"><button type="submit" disabled?={ f.Locked != "" }>create account</button></div>
		</form>
	}
}

templ RegistrationClosed(p Page, msg string) {
	@Layout(p) {
		<section class="box auth">
			<h1 class="huge">register</h1>
			<p>{ msg }</p>
			<p class="muted small">already have an account? <a href="/login">log in</a>.</p>
		</section>
	}
}

templ honeypot(f AuthForm) {
	if f.Honeypot {
		<div class="form-trap" aria-hidden="true">
			<label>leave this field empty <input type="text" name={ HoneypotField } value="" tabindex="-1" autocomplete="off"/></label>
		</div>
	}
}

templ captchaField(f AuthForm) {
	if f.Locked != "" {
		<p class="captcha-locked">!! { f.Locked }</p>
	} else if f.Captcha != nil {
		<div class="captcha">
			<label for="captcha_value">captcha <span class="muted">(type the letters and digits)</span></label>
			<img src={ "/captcha/" + f.Captcha.ID + ".png" } alt="captcha: type the characters shown" width={ itoa(f.Captcha.Width) } height={ itoa(f.Captcha.Height) }/>
			<input type="hidden" name="captcha_id" value={ f.Captcha.ID }/>
			<input id="captcha_value" type="text" name="captcha_value" required autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"/>
		</div>
	}
}

templ About(p Page, title, body string) {
	@Layout(p) {
		<article class="box about">
			<h1 class="huge">{ title }</h1>
			<div class="body">
				@markdown(body)
			</div>
		</article>
	}
}
