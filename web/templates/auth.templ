package templates

templ Login(p Page, username string) {
	@Layout(p) {
		<form method="post" action="/login" class="box auth">
			<h1 class="huge">log in</h1>
			@csrfField(p)
			<label for="username">username</label>
			<input id="username" type="text" name="username" value={ username } autocomplete="username" required autofocus/>
			<label for="password">password</label>
			<input id="password" type="password" name="password" autocomplete="current-password" required/>
			<div class="row-end"><button type="submit">enter</button></div>
			<p class="muted small">no account? <a href="/register">register</a>.</p>
		</form>
	}
}

templ Register(p Page, username string) {
	@Layout(p) {
		<form method="post" action="/register" class="box auth">
			<h1 class="huge">register</h1>
			<p class="muted small">no email. no phone. pick a name and a password. lose the password, lose the account.</p>
			@csrfField(p)
			<label for="username">username <span class="muted">(3-20: a-z 0-9 _)</span></label>
			<input id="username" type="text" name="username" value={ username } pattern="[A-Za-z0-9_]{3,20}" autocomplete="username" required autofocus/>
			<label for="password">password <span class="muted">(8+ chars)</span></label>
			<input id="password" type="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required/>
			<label for="password_confirm">again</label>
			<input id="password_confirm" type="password" name="password_confirm" minlength="8" maxlength="72" autocomplete="new-password" required/>
			<div class="row-end"><button type="submit">create account</button></div>
		</form>
	}
}
